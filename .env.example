# api
PORT=5000

GIN_MODE=debug

# In Docker Compose use hostname `db`; for a local (non-Docker) API use localhost.
DATABASE_URL=postgresql://postgres:postgres@db:5432/cartspace?sslmode=disable

JWT_REFRESH_SECRET=refresh-secret
JWT_ACCESS_SECRET=access-secret

CLOUDINARY_CLOUD_NAME=cloudinary-cloud-name
CLOUDINARY_API_KEY=cloudinary-api-key
CLOUDINARY_API_SECRET=cloudinary-api-secret

FRONTEND_URL=http://localhost:3000
COOKIE_DOMAIN=localhost

OPENAPI_PATH=openapi.json

# postgres (used by the db container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cartspace

# web
NEXT_PUBLIC_API_URL=http://localhost:5000
INTERNAL_API_URL=http://api:5000
