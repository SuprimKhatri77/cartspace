# Wrap any value containing $ in single quotes (e.g. KEY='a$b'), or docker compose will try to expand it.

# api
PORT=5000

GIN_MODE=debug

# In Docker Compose use hostname `db`; for a local (non-Docker) API use localhost.
DATABASE_URL=postgresql://<user>:<password>@db:5432/cartspace?sslmode=disable

# generate with: openssl rand -hex 32
JWT_REFRESH_SECRET=
JWT_ACCESS_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

FRONTEND_URL=http://localhost:3000
# comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-For (e.g. your load
# balancer). Leave empty in dev so clients can't spoof their ip.
TRUSTED_PROXIES=
COOKIE_DOMAIN=localhost

OPENAPI_PATH=openapi.json

# postgres (used by the db container)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=cartspace

# seed: `bun run db:seed` creates an admin and a customer (passwords required, min 8 chars)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_EMAIL=customer@example.com
SEED_CUSTOMER_PASSWORD=
# `bun run db:seed:catalog` adds demo categories and products through the
# running API as the seeded admin (default URL: NEXT_PUBLIC_API_URL)
# SEED_API_URL=http://localhost:5000

# web
NEXT_PUBLIC_API_URL=http://localhost:5000
INTERNAL_API_URL=http://api:5000
